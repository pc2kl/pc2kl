PROGRAM TMOT2
%NOLOCKGROUP
VAR
 p1, p2 : POSITION
 x1 : XYZWPR
 j1 : JOINTPOS
BEGIN
 $GROUP[1].$MOTYPE = JOINT
 MOVE TO p1
 MOVE TO j1
 MOVE TO x1 NOWAIT
 MOVE NEAR p1 BY 50.0
 MOVE AWAY 100.0
 MOVE RELATIVE x1
 MOVE AXIS 1 BY 10.0
 MOVE TO p1 VIA p2
 MOVE TO p1,
  WHEN DIN[1] DO DOUT[1] = TRUE
 ENDMOVE
END TMOT2
