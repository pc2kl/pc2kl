PROGRAM F_COND3_T
VAR
    i, j : INTEGER
    r : REAL
    b : BOOLEAN
BEGIN
    WAIT FOR (i > EVAL(j + 1))
    WAIT FOR (i > -5)
    WAIT FOR DIN[1] AND (i > 3)
    WAIT FOR GIN[1] > 3
    WAIT FOR GIN[1] > j
    WAIT FOR GIN[2] = EVAL(j)
    WAIT FOR AIN[1] < 100
    WAIT FOR DIN[2] = b
    WAIT FOR DIN[2] = EVAL(b)
    WAIT FOR (r > EVAL(r)) OR (i < j)
    CONDITION[5]:
        WHEN GIN[1] > EVAL(i * 2) DO DOUT[1] = TRUE
        WHEN DIN[1] DO HOLD
    ENDCONDITION
END F_COND3_T
