PROGRAM TCOND
%NOLOCKGROUP
VAR
 i, j: INTEGER
 b: BOOLEAN
 r: REAL
 tmr: INTEGER
ROUTINE hnd
BEGIN
 i = i + 1
END hnd
BEGIN
 WAIT FOR DIN[1]
 WAIT FOR DIN[2] = OFF
 WAIT FOR DIN[i] = ON
 WAIT FOR i > 5
 WAIT FOR (i > 5) AND (j < 3)
 WAIT FOR DIN[1] OR DIN[2]
 WAIT FOR DIN[1]+
 WAIT FOR DIN[1]-
 WAIT FOR r >= 1.5
 WAIT FOR EVENT[3]
 CONDITION[1]:
   WHEN DIN[1] DO
     DOUT[2] = TRUE
     i = 5
 ENDCONDITION
 CONDITION[2]:
   WHEN DIN[3] = OFF DO
     hnd
     ENABLE CONDITION[2]
   WHEN i > 3 DO
     PAUSE
 ENDCONDITION
 CONDITION[3]:
   WHEN ERROR[11002] DO
     ABORT
 ENDCONDITION
 CONDITION[4]:
   WHEN ABORT DO
     DOUT[1] = OFF
 ENDCONDITION
 CONDITION[5]:
   WHEN PAUSE DO
     DOUT[1] = OFF
     RESUME
 ENDCONDITION
 CONDITION[6]:
   WHEN tmr > 1000 DO
     SIGNAL EVENT[7]
 ENDCONDITION
 ENABLE CONDITION[1]
 DISABLE CONDITION[1]
 PURGE CONDITION[2]
 SIGNAL EVENT[3]
 CONNECT TIMER TO tmr
 DISCONNECT TIMER tmr
 CANCEL
 HOLD
 UNHOLD
 STOP
 RESUME
 DELAY 500
END TCOND
