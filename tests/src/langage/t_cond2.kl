PROGRAM TCOND2
%NOLOCKGROUP
VAR
 i, j: INTEGER
 r, r2: REAL
 b, b2: BOOLEAN
BEGIN
 WAIT FOR i = 5
 WAIT FOR i <> 5
 WAIT FOR i < 5
 WAIT FOR i <= 5
 WAIT FOR i > 5
 WAIT FOR i >= 5
 WAIT FOR i = j
 WAIT FOR i <> j
 WAIT FOR i < j
 WAIT FOR i <= j
 WAIT FOR i > j
 WAIT FOR i >= j
 WAIT FOR r = 1.5
 WAIT FOR r <> 1.5
 WAIT FOR r < 1.5
 WAIT FOR r <= 1.5
 WAIT FOR r > 1.5
 WAIT FOR r >= 1.5
 WAIT FOR r = r2
 WAIT FOR r <> r2
 WAIT FOR r < r2
 WAIT FOR r <= r2
 WAIT FOR r > r2
 WAIT FOR r >= r2
 WAIT FOR b = TRUE
 WAIT FOR b <> TRUE
 WAIT FOR b < TRUE
 WAIT FOR b <= TRUE
 WAIT FOR b > TRUE
 WAIT FOR b >= TRUE
 WAIT FOR b = b2
 WAIT FOR b <> b2
 WAIT FOR b < b2
 WAIT FOR b <= b2
 WAIT FOR b > b2
 WAIT FOR b >= b2
 WAIT FOR GIN[1] = 5
 WAIT FOR GIN[1] <> 5
 WAIT FOR GIN[1] < 5
 WAIT FOR GIN[1] <= 5
 WAIT FOR GIN[1] > 5
 WAIT FOR GIN[1] >= 5
 WAIT FOR AIN[2] = j
 WAIT FOR AIN[2] <> j
 WAIT FOR AIN[2] < j
 WAIT FOR AIN[2] <= j
 WAIT FOR AIN[2] > j
 WAIT FOR AIN[2] >= j
 WAIT FOR DIN[1] = b
 WAIT FOR DIN[1] <> b
 WAIT FOR DIN[1] < b
 WAIT FOR DIN[1] <= b
 WAIT FOR DIN[1] > b
 WAIT FOR DIN[1] >= b
 WAIT FOR DOUT[3]
 WAIT FOR NOT DIN[4]
 WAIT FOR DIN[5] = TRUE
 WAIT FOR RDI[1]
 WAIT FOR ERROR[*]
 WAIT FOR CONTINUE
 WAIT FOR SEMAPHORE[2]
 WAIT FOR DIN[1] AND DIN[2] AND DIN[3]
 WAIT FOR (i=1) OR (i=2) OR DIN[3]
END TCOND2
