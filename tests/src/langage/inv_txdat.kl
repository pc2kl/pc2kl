PROGRAM INV_TXDAT
%COMMENT = 'PCDK: Posn Move'
%SYSTEM
%NOLOCKGROUP
%INVISIBLE

TYPE
	MOVENODE_T = STRUCTURE
		POS1 : JOINTPOS
		POS2 : JOINTPOS IN GROUP[2]
		POS3 : JOINTPOS IN GROUP[3]
	ENDSTRUCTURE

VAR
	GRP_MASK : INTEGER
	LOW_GRP : INTEGER
	POS1 : JOINTPOS
	POS2 : JOINTPOS IN GROUP[2]
	POS3 : JOINTPOS IN GROUP[3]
	MOTYPE : INTEGER
	MOVE_PTH : PATH NODEDATA = MOVENODE_T
	NUM_NODES : INTEGER
	STATUS : INTEGER










































BEGIN
	SET_TSK_ATTR('', 111, 8, STATUS)




	NUM_NODES = PATH_LEN(MOVE_PTH)
	IF NUM_NODES < 1 THEN
		APPEND_NODE(MOVE_PTH, STATUS)
	ENDIF




	SELECT LOW_GRP OF
	CASE(2):
		MOTYPE = $GROUP[2].$MOTYPE
	CASE(3):
		MOTYPE = $GROUP[3].$MOTYPE
	ELSE:
		MOTYPE = $GROUP[1].$MOTYPE
	ENDSELECT

	SELECT GRP_MASK OF
	CASE(1):
		$MCR_GRP[1].$HOLD = FALSE
		MOVE_PTH[1].POS1 = POS1
		WITH $SPEED = 500, $MOTYPE = MOTYPE MOVE TO MOVE_PTH[1]
	CASE(2):

		$MCR_GRP[2].$HOLD = FALSE
		MOVE_PTH[1].POS2 = POS2
		WITH $GROUP[2].$SPEED = 500, $GROUP[2].$MOTYPE = MOTYPE MOVE TO MOVE_PTH[1]
	CASE(3):

		$MCR_GRP[1].$HOLD = FALSE
		$MCR_GRP[2].$HOLD = FALSE
		MOVE_PTH[1].POS1 = POS1
		MOVE_PTH[1].POS2 = POS2
		WITH $GROUP[1].$SPEED = 500, $GROUP[1].$MOTYPE = MOTYPE, $GROUP[2].$SPEED = 500, $GROUP[2].$MOTYPE = MOTYPE MOVE TO MOVE_PTH[1]
	CASE(4):



		$MCR_GRP[3].$HOLD = FALSE
		MOVE_PTH[1].POS3 = POS3
		WITH $GROUP[3].$SPEED = 500, $GROUP[3].$MOTYPE = MOTYPE MOVE TO MOVE_PTH[1]
	CASE(5):

		$MCR_GRP[1].$HOLD = FALSE
		$MCR_GRP[3].$HOLD = FALSE
		MOVE_PTH[1].POS1 = POS1
		MOVE_PTH[1].POS3 = POS3
		WITH $GROUP[1].$SPEED = 500, $GROUP[1].$MOTYPE = MOTYPE, $GROUP[3].$SPEED = 500, $GROUP[3].$MOTYPE = MOTYPE MOVE TO MOVE_PTH[1]
	CASE(6):



		$MCR_GRP[2].$HOLD = FALSE
		$MCR_GRP[3].$HOLD = FALSE
		MOVE_PTH[1].POS2 = POS2
		MOVE_PTH[1].POS3 = POS3
		WITH $GROUP[2].$SPEED = 500, $GROUP[2].$MOTYPE = MOTYPE, $GROUP[3].$SPEED = 500, $GROUP[3].$MOTYPE = MOTYPE MOVE TO MOVE_PTH[1]
	CASE(7):



		$MCR_GRP[1].$HOLD = FALSE
		$MCR_GRP[2].$HOLD = FALSE
		$MCR_GRP[3].$HOLD = FALSE
		MOVE_PTH[1].POS1 = POS1
		MOVE_PTH[1].POS2 = POS2
		MOVE_PTH[1].POS3 = POS3
		WITH $GROUP[1].$SPEED = 500, $GROUP[1].$MOTYPE = MOTYPE, $GROUP[2].$SPEED = 500, $GROUP[2].$MOTYPE = MOTYPE, $GROUP[3].$SPEED = 500, $GROUP[3].$MOTYPE = MOTYPE MOVE TO MOVE_PTH[1]
	ELSE:





	ENDSELECT

END INV_TXDAT
