PROGRAM w_enum
%NOLOCKGROUP
VAR
  p : POSITION
  q : POSITION
BEGIN
  $GROUP[1].$MOTYPE = JOINT
  $GROUP[1].$MOTYPE = LINEAR
  $GROUP[1].$MOTYPE = CIRCULAR
  $GROUP[1].$TERMTYPE = FINE
  $GROUP[1].$TERMTYPE = COARSE
  $GROUP[1].$TERMTYPE = NOSETTLE
  $GROUP[1].$TERMTYPE = NODECEL
  $GROUP[1].$TERMTYPE = VARDECEL
  $GROUP[1].$SEGTERMTYPE = VARDECEL
  $GROUP[1].$ORIENT_TYPE = RSWORLD
  $GROUP[1].$ORIENT_TYPE = AESWORLD
  $GROUP[1].$ORIENT_TYPE = WRISTJOINT
  WITH $MOTYPE = CIRCULAR MOVE TO p VIA q
  WITH $TERMTYPE = NOSETTLE MOVE TO p
  WITH $TERMTYPE = VARDECEL, $SEGTERMTYPE = NODECEL MOVE TO p
  WITH $ORIENT_TYPE = AESWORLD MOVE TO p
  WITH $ORIENT_TYPE = WRISTJOINT MOVE TO p
END w_enum
