PROGRAM TCOND3
%NOLOCKGROUP
VAR
 i, j: INTEGER
 r, r2: REAL
 b, b2: BOOLEAN
 f: FILE
ROUTINE hnd
BEGIN
 i=1
END hnd
BEGIN
 CONDITION[1]:
  WHEN DIN[1] DO
   i = 5
 ENDCONDITION
 CONDITION[2]:
  WHEN DIN[1] DO
   i = j
 ENDCONDITION
 CONDITION[3]:
  WHEN DIN[1] DO
   r = 1.5
 ENDCONDITION
 CONDITION[4]:
  WHEN DIN[1] DO
   r = r2
 ENDCONDITION
 CONDITION[5]:
  WHEN DIN[1] DO
   b = TRUE
 ENDCONDITION
 CONDITION[6]:
  WHEN DIN[1] DO
   b = b2
 ENDCONDITION
 CONDITION[7]:
  WHEN DIN[1] DO
   DOUT[1] = TRUE
 ENDCONDITION
 CONDITION[8]:
  WHEN DIN[1] DO
   DOUT[2] = b
 ENDCONDITION
 CONDITION[9]:
  WHEN DIN[1] DO
   GOUT[1] = 5
 ENDCONDITION
 CONDITION[10]:
  WHEN DIN[1] DO
   GOUT[1] = j
 ENDCONDITION
 CONDITION[11]:
  WHEN DIN[1] DO
   AOUT[1] = i
 ENDCONDITION
 CONDITION[12]:
  WHEN DIN[1] DO
 ENDCONDITION
 CONDITION[13]:
  WHEN DIN[1] DO
   i = GIN[2]
 ENDCONDITION
 CONDITION[14]:
  WHEN DIN[1] DO
   b = DIN[2]
 ENDCONDITION
 CONDITION[15]:
  WHEN DIN[1] DO
   hnd
 ENDCONDITION
 CONDITION[16]:
  WHEN DIN[1] DO
   ENABLE CONDITION[2]
 ENDCONDITION
 CONDITION[17]:
  WHEN DIN[1] DO
   DISABLE CONDITION[3]
 ENDCONDITION
 CONDITION[18]:
  WHEN DIN[1] DO
 ENDCONDITION
 CONDITION[19]:
  WHEN DIN[1] DO
   SIGNAL EVENT[5]
 ENDCONDITION
 CONDITION[20]:
  WHEN DIN[1] DO
   NOABORT
 ENDCONDITION
 CONDITION[21]:
  WHEN DIN[1] DO
   NOPAUSE
 ENDCONDITION
 CONDITION[22]:
  WHEN DIN[1] DO
   PAUSE
 ENDCONDITION
 CONDITION[23]:
  WHEN DIN[1] DO
   ABORT
 ENDCONDITION
 CONDITION[24]:
  WHEN DIN[1] DO
   CANCEL
 ENDCONDITION
 CONDITION[25]:
  WHEN DIN[1] DO
   STOP
 ENDCONDITION
 CONDITION[26]:
  WHEN DIN[1] DO
   HOLD
 ENDCONDITION
 CONDITION[27]:
  WHEN DIN[1] DO
   UNHOLD
 ENDCONDITION
 CONDITION[28]:
  WHEN DIN[1] DO
   RESUME
 ENDCONDITION
 CONDITION[29]:
  WHEN DIN[1] DO
   UNPAUSE
 ENDCONDITION
 CONDITION[30]:
  WHEN DIN[1] DO
 ENDCONDITION
 CONDITION[31]:
  WHEN DIN[1] DO
   PULSE DOUT[3] FOR 100
 ENDCONDITION
 CONDITION[32]:
  WHEN DIN[1] DO
   i = -1
 ENDCONDITION
 CONDITION[33]:
  WHEN DIN[1] DO
   r = -1.5
 ENDCONDITION
 CONDITION[34]:
  WHEN DIN[1] DO
 ENDCONDITION
 CONDITION[99]:
  WHEN DIN[1] DO i=1
  WHEN DIN[2] DO i=2
 ENDCONDITION
 CONDITION[98]: WITH $SCAN_TIME = 50
  WHEN DIN[1] DO i=1
 ENDCONDITION
 CONDITION[97]:
  WHEN DIN[1] OR DIN[2] DO i=1, j=2, DOUT[3]=ON
 ENDCONDITION
END TCOND3
