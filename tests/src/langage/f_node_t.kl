PROGRAM F_NODE_T
VAR
path1   :PATH
i : INTEGER
BEGIN
    MOVE ALONG path1,
        WHEN TIME 100 BEFORE NODE[2] DO DOUT[1] = TRUE
        WHEN TIME 200 AFTER NODE[3] DO DOUT[2] = TRUE
        WHEN TIME i BEFORE NODE[i] DO DOUT[3] = TRUE
        WHEN AT NODE[4] DO DOUT[4] = TRUE
    ENDMOVE
END F_NODE_T
