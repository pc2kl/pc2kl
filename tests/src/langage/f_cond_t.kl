PROGRAM F_COND_T
VAR
    TIMER_VAR : INTEGER
ROUTINE UPD_STATUS
BEGIN
END UPD_STATUS
BEGIN
    DISABLE CONDITION[1]
    CONDITION[1]:
        WHEN (TIMER_VAR > EVAL(100+TIMER_VAR))OR SEMAPHORE[1] OR (EVENT[1]) DO WITH $PRIORITY = 1 UPD_STATUS
        SIGNAL EVENT[1]
        NOMESSAGE
        NOPAUSE
        NOABORT
        ABORT
        CONTINUE
        PAUSE
        UNPAUSE
        SIGNAL SEMAPHORE[1]
        ENABLE CONDITION[1]
        PULSE DOUT[1] FOR 300
    ENDCONDITION
    CONDITION[2]:WITH $SCAN_TIME = 5
        WHEN DOUT[1]+ DO
    ENDCONDITION
    CONDITION[3]:
        WHEN DOUT[1]- DO
    ENDCONDITION
    CONDITION[4]:
        WHEN PAUSE DO
    ENDCONDITION
    ENABLE CONDITION[1]
    PURGE CONDITION[1]
END F_COND_T
