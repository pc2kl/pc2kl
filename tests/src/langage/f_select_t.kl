PROGRAM F_SELECT_T
VAR i : INTEGER
ROUTINE f(x : INTEGER) : INTEGER
BEGIN
  SELECT x OF
    CASE(1): RETURN(10)
    CASE(2,3): RETURN(20)
    ELSE:
  ENDSELECT
  RETURN(0)
END f
ROUTINE g(x : INTEGER)
BEGIN
  SELECT x OF
    CASE(1): RETURN
    ELSE: RETURN
  ENDSELECT
END g
BEGIN
  SELECT i OF
    CASE(1): i = 2
    ELSE:
  ENDSELECT
  i = f(i)
  g(i)
END F_SELECT_T
