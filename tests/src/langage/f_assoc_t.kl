PROGRAM F_ASSOC_T
VAR
 g : GROUP_ASSOC
 g2 : GROUP_ASSOC IN GROUP[2]
 c : COMMON_ASSOC
 p : PATH
 i : INTEGER
 b : BOOLEAN
BEGIN
 i = g.SEGRELSPEED
 i = g.SEGMOTYPE
 i = g.SEGORIENTYPE
 b = g.SEGBREAK
 g2.SEGRELSPEED = 3
 i = c.SEGTERMTYPE
 i = c.SEGDECELTOL
 i = c.SEGRELACCEL
 i = c.SEGTIMESHFT
 c.SEGTERMTYPE = 2
 i = p[1].GROUP_DATA.SEGRELSPEED
 i = p[1].COMMON_DATA.SEGTERMTYPE
 p[1].GROUP_DATA = g
 c = p[2].COMMON_DATA
END F_ASSOC_T
