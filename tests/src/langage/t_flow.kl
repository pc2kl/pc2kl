PROGRAM TFLOW
%NOLOCKGROUP
VAR
 i, j, k: INTEGER
 b: BOOLEAN
BEGIN
 IF b THEN
 ENDIF
 IF b THEN
 ELSE
 ENDIF
 IF b THEN
 ELSE
   i = 1
 ENDIF
 WHILE b DO
 ENDWHILE
 REPEAT
   REPEAT
     i = i + 1
   UNTIL i > 3
 UNTIL j > 4
 REPEAT
   IF i = 1 THEN
     j = 2
   ENDIF
 UNTIL b
 REPEAT
   IF i = 1 THEN
     j = 2
   ELSE
     j = 3
   ENDIF
 UNTIL b
 WHILE i < 5 DO
   FOR j = 1 TO 3 DO
     IF j = 2 THEN
       GOTO out
     ENDIF
   ENDFOR
   i = i + 1
 ENDWHILE
 out::
 i = 0; j = 0
 IF i = 0 THEN j = 1; ENDIF
 SELECT i OF
   CASE(1):
     IF b THEN
       j = 1
     ELSE
       j = 2
     ENDIF
   CASE(2):
     SELECT j OF
       CASE(1): k = 1
       CASE(2): k = 2
       ELSE: k = 3
     ENDSELECT
   CASE(3):
   ELSE:
 ENDSELECT
 SELECT i OF
   CASE(1): k = 1
 ENDSELECT
 IF b THEN
   RETURN
 ENDIF
 WHILE TRUE DO
   IF b THEN
     GOTO fin
   ENDIF
 ENDWHILE
 fin::
 FOR i = 1 TO 10 DO
   FOR j = i DOWNTO 1 DO
     k = k + 1
   ENDFOR
 ENDFOR
 IF (i = 1) AND NOT b THEN
   IF j = 1 THEN
     k = 1
   ELSE
     IF j = 2 THEN
       k = 2
     ELSE
       k = 3
     ENDIF
   ENDIF
 ENDIF
END TFLOW
